<mxfile host="app.diagrams.net">
  <diagram name="transfer管控流程" id="transfer-control-flow">
    <mxGraphModel dx="1420" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- 开始 -->
        <mxCell id="start" value="开始" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="80" y="60" width="80" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 黑名单校验 -->
        <mxCell id="blacklist" value="黑名单校验" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="220" y="60" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="blacklist_no" value="拒绝转账" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="400" y="30" width="100" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 司法冻结校验 -->
        <mxCell id="freeze" value="司法冻结校验" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="220" y="150" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="freeze_no" value="拒绝转账" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="400" y="120" width="100" height="40" as="geometry"/>
        </mxCell>
        
        <!-- DID校验 -->
        <mxCell id="did" value="接收人是否注册DID" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="220" y="240" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="did_no" value="拒绝转账" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="400" y="210" width="100" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 白名单校验 -->
        <mxCell id="whitelist" value="接收人是否白名单地址" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="220" y="330" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="whitelist_no" value="拒绝转账" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="400" y="300" width="100" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 审核通过的交易请求 -->
        <mxCell id="request" value="是否审核通过的交易请求" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="220" y="420" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="request_no" value="拒绝转账" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="400" y="390" width="100" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 限额校验 -->
        <mxCell id="limit" value="是否低于累计限额" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="220" y="510" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="limit_no" value="拒绝转账" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="400" y="480" width="100" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 通过 -->
        <mxCell id="pass" value="转账通过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="220" y="600" width="100" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 结束 -->
        <mxCell id="end" value="结束" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="80" y="700" width="80" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 连线 -->
        <mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="start" target="blacklist"/>
        <mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="blacklist" target="blacklist_no"/>
        <mxCell id="edge3" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="blacklist" target="freeze"/>
        <mxCell id="edge4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="freeze" target="freeze_no"/>
        <mxCell id="edge5" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="freeze" target="did"/>
        <mxCell id="edge6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="did" target="did_no"/>
        <mxCell id="edge7" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="did" target="whitelist"/>
        <mxCell id="edge8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="whitelist" target="whitelist_no"/>
        <mxCell id="edge9" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="whitelist" target="request"/>
        <mxCell id="edge10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="request" target="request_no"/>
        <mxCell id="edge11" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="request" target="limit"/>
        <mxCell id="edge12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="limit" target="limit_no"/>
        <mxCell id="edge13" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="limit" target="pass"/>
        <mxCell id="edge14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="pass" target="end"/>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
