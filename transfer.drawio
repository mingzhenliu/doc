<mxfile host="app.diagrams.net">
  <diagram name="transfer管控流程" id="transfer-control-flow">
    <mxGraphModel dx="1420" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- 开始 -->
        <mxCell id="start" value="开始" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="80" y="60" width="80" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 黑名单校验 -->
        <mxCell id="blacklist" value="黑名单校验" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="220" y="60" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="blacklist_no" value="拒绝转账" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="400" y="30" width="100" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 司法冻结校验 -->
        <mxCell id="freeze" value="司法冻结校验" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="220" y="150" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="freeze_no" value="拒绝转账" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="400" y="120" width="100" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 合规合约校验 -->
        <mxCell id="compliance" value="合规合约校验" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="1">
          <mxGeometry x="80" y="250" width="600" height="260" as="geometry"/>
        </mxCell>
        
        <!-- 合规合约校验内部流程 -->
        <mxCell id="did" value="接收人是否注册DID" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="compliance">
          <mxGeometry x="40" y="20" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="did_no" value="拒绝转账" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="compliance">
          <mxGeometry x="200" y="0" width="100" height="40" as="geometry"/>
        </mxCell>
        
        <mxCell id="whitelist" value="接收人是否白名单地址" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="compliance">
          <mxGeometry x="40" y="100" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="whitelist_no" value="拒绝转账" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="compliance">
          <mxGeometry x="200" y="80" width="100" height="40" as="geometry"/>
        </mxCell>
        
        <mxCell id="request" value="是否审核通过的交易请求" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="compliance">
          <mxGeometry x="40" y="180" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="request_no" value="拒绝转账" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="compliance">
          <mxGeometry x="200" y="160" width="100" height="40" as="geometry"/>
        </mxCell>
        
        <mxCell id="limit" value="是否低于累计限额" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="compliance">
          <mxGeometry x="40" y="260" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="limit_no" value="拒绝转账" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="compliance">
          <mxGeometry x="200" y="240" width="100" height="40" as="geometry"/>
        </mxCell>
        
        <mxCell id="pass" value="转账通过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="compliance">
          <mxGeometry x="40" y="340" width="100" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 结束 -->
        <mxCell id="end" value="结束" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="80" y="540" width="80" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 连线 -->
        <mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="start" target="blacklist">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="blacklist" target="blacklist_no">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="80" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge3" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="blacklist" target="freeze">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="freeze" target="freeze_no">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="170" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge5" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="freeze" target="compliance">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="compliance" source="did" target="did_no">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge7" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="compliance" source="did" target="whitelist">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="compliance" source="whitelist" target="whitelist_no">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge9" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="compliance" source="whitelist" target="request">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="compliance" source="request" target="request_no">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge11" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="compliance" source="request" target="limit">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="compliance" source="limit" target="limit_no">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge13" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="compliance" source="limit" target="pass">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="compliance" target="end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
