@startuml
!theme plain

participant "Bank A" as BA
participant "Escrow Contract" as EC  
participant "TD Token (ERC20)" as TD
participant "Ensemble IL" as EIL
participant "CeBM Network" as CM
participant "Bank B" as BB

== Stage 1: Initiation ==
BA -> EIL: 1. Payment instruction (100 TD)
EIL -> BB: 2. Notify transfer request

== Stage 2a: TD Escrow ==
BA -> EC: 3. initiateTransfer(BankB, 100)
EC -> TD: 4. transferFrom(BankA, Escrow, 100)
TD --> EC: 5. Transfer successful
EC --> BA: 6. TD escrow confirmed
BA -> EIL: 7. Notify TD escrow complete

== Stage 2b: RTGS Escrow ==
EIL -> BA: 10. Request RTGS transfer
BA -> CM: 11. Transfer 100 RTGS to Escrow
CM --> BA: 12. RTGS confirmed
CM -> EIL: 13. Validate RTGS received

== Stage 4: Completion ==
CM -> BB: 15. Release 100 RTGS to Bank B
CM -> EIL: 17. Notify RTGS complete
EIL -> EC: 18. confirmRTGS(transferId)
EC -> TD: 19. transfer(BankB, 100)
TD --> BB: 20. 100 TD tokens received
EIL -> BA: 22. Transfer completion
EIL -> BB: 23. Transfer completion

note over BA, BB: Final: Bank A: -100 TD, -100 RTGS\nBank B: +100 TD, +100 RTGS

@enduml
